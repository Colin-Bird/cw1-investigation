# Rule 1: Detect the initial download request for gerv.gun
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"LOCAL MALWARE-DOWNLOAD Request for gerv.gun from matied.com"; flow:to_server,established; content:"GET"; http_method; content:"/gerv.gun"; http_uri; nocase; content:"Host|3A| matied.com"; http_header; nocase; classtype:trojan-activity; sid:1000001; rev:2;)

# Rule 2: Detect a workstation opening many outbound SMTP connections
alert tcp $HOME_NET any -> $EXTERNAL_NET 25 (msg:"LOCAL MALWARE-BEHAVIOR Possible spambot - many outbound SMTP connection attempts"; flags:S; detection_filter:track by_src, count 20, seconds 60; classtype:trojan-activity; sid:1000002; rev:2;)